# 后端服务环境变量模板
# 复制此文件为 .env 并填写真实值

# ===== Gemini API 配置 =====
# Gemini API Key（必填）
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# ===== Redis 配置 =====
# Redis 服务器地址（默认 redis）
REDIS_HOST=redis

# Redis 服务器端口（默认 6379）
REDIS_PORT=6379

# Redis 数据库编号（默认 0）
REDIS_DB=0

# ===== API 安全配置 =====
# API 签名密钥（与客户端一致，必填）
# 用于验证客户端请求的 HMAC-SHA256 签名
# 生成方法: openssl rand -hex 32
API_SECRET_KEY=your-secret-key-here

# API 限流配置（每分钟最大请求数）
API_RATE_LIMIT=15

# 全局限流配置（每天最大请求数）
GLOBAL_RATE_LIMIT=2000

# ===== CORS 配置 =====
# 允许的跨域来源（逗号分隔）
# 生产环境改为具体域名，如: https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=*

# ===== 日志配置 =====
# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# ===== 服务配置 =====
# 服务器监听端口（默认 8000）
PORT=8000
